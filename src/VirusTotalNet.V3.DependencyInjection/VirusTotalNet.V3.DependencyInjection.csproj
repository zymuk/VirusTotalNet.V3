<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>VirusTotalNet.V3.DependencyInjection</AssemblyName>
    <RootNamespace>VirusTotalNet.V3.DependencyInjection</RootNamespace>
    <PackageId>VirusTotalNet.V3.DependencyInjection</PackageId>
    <Version>1.0.1</Version>
    <Authors>Tran T. Ngoc</Authors>
    <Description>Dependency-injection glue for VirusTotalNet.V3: AddVirusTotal extension registering the client, options and all module clients. Kept separate so the core library stays free of Microsoft.Extensions.* dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/zymuk/VirusTotalNet.V3.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn.Replace(';1591', '').Replace('1591', ''))</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirusTotalNet.V3\VirusTotalNet.V3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\MIGRATING_FROM_V2.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>